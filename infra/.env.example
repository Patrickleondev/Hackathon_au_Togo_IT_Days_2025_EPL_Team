# GuardIAn — environment variables (TEMPLATE — NO REAL SECRETS HERE)
#
# Copy to `.env`, then REGENERATE every value below before running
# in any environment other than your local laptop.
#
#   cp infra/.env.example infra/.env
#   # then for each value:
#   #   SECRET_KEY        : openssl rand -hex 32
#   #   POSTGRES_PASSWORD : openssl rand -base64 24
#   #   BOOTSTRAP_ADMIN_* : pick yourself, change after first login

# ─── App ──────────────────────────────────────────────────────────────────
APP_ENV=dev
APP_VERSION=2.0.0
APP_NAME=GuardIAn

# ─── Security ─────────────────────────────────────────────────────────────
SECRET_KEY=REPLACE_ME_WITH_OUTPUT_OF_openssl_rand_hex_32
JWT_ACCESS_TTL_MINUTES=60
JWT_AGENT_TTL_DAYS=30

# Bootstrap admin (created on first run when DB is empty)
BOOTSTRAP_ADMIN_EMAIL=admin@guardian.local
BOOTSTRAP_ADMIN_PASSWORD=REPLACE_ME_BEFORE_RUNNING

# Pre-shared secret required by /agents/enroll. Generate with: openssl rand -hex 32
# REQUIRED in production. If unset in dev, enrollment is allowed with a warning.
AGENT_ENROLLMENT_SECRET=REPLACE_ME_WITH_OUTPUT_OF_openssl_rand_hex_32

# ─── Database ─────────────────────────────────────────────────────────────
POSTGRES_USER=guardian
POSTGRES_PASSWORD=REPLACE_ME_WITH_RANDOM
POSTGRES_DB=guardian
# DATABASE_URL is composed automatically by docker-compose from the variables above.
# Override it ONLY if you target an external database.
# DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/DBNAME

# ─── Redis ────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ─── CORS ─────────────────────────────────────────────────────────────────
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://127.0.0.1:5173"]

# ─── Logging ──────────────────────────────────────────────────────────────
LOG_LEVEL=INFO

# ─── Storage paths inside the container ───────────────────────────────────
STORAGE_DIR=/var/lib/guardian
UPLOADS_DIR=/var/lib/guardian/uploads
QUARANTINE_DIR=/var/lib/guardian/quarantine
MODELS_DIR=/var/lib/guardian/models
RULES_DIR=/var/lib/guardian/rules
MAX_UPLOAD_MB=100

# ─── Detector thresholds ──────────────────────────────────────────────────
THRESHOLD_LOW=0.40
THRESHOLD_MEDIUM=0.65
THRESHOLD_HIGH=0.85

# ─── Frontend ─────────────────────────────────────────────────────────────
VITE_API_URL=http://localhost:8000
VITE_APP_NAME=GuardIAn

# ─── Threat Intelligence (auto-update every 6h) ──────────────────────────
INTEL_ENABLED=true
INTEL_UPDATE_INTERVAL_HOURS=6
INTEL_RETENTION_DAYS=90

# abuse.ch — free Auth-Key required since 2024.
# Register at https://auth.abuse.ch/ to get one. Used by:
#   MalwareBazaar, URLhaus, ThreatFox, Feodo Tracker, YARAify
ABUSE_CH_AUTH_KEY=

# AbuseIPDB — free 1000 req/day. Register at https://www.abuseipdb.com/account/api
# Leave empty and set INTEL_ABUSEIPDB_ENABLED=false if you don't want it.
ABUSEIPDB_API_KEY=
INTEL_ABUSEIPDB_ENABLED=false

# AlienVault OTX — free. Register at https://otx.alienvault.com/api
OTX_API_KEY=
INTEL_OTX_ENABLED=false

# Per-feed kill-switches (override without redeploy)
INTEL_MALWARE_BAZAAR_ENABLED=true
INTEL_URLHAUS_ENABLED=true
INTEL_THREATFOX_ENABLED=true
INTEL_FEODO_ENABLED=true
INTEL_YARAIFY_ENABLED=true


# --- Assistant / chatbot ---------------------------------------------------
# Optional: bind a paid LLM (Claude, GPT, Mistral, ...) to the chatbot.
# Default 'none' = answers come 100% from the local FAQ knowledge base
# (no outbound calls, no API key needed).
# Allowed values: none | openai | anthropic | mistral | openrouter | ollama
LLM_PROVIDER=none
LLM_API_KEY=
LLM_MODEL=
LLM_BASE_URL=
LLM_MAX_TOKENS=512
LLM_TIMEOUT_SECONDS=20

# Public chatbot rate limit (per client IP, sliding 60s window)
CHAT_RATE_PER_MINUTE=30
