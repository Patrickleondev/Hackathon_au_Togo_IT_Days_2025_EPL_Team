# RansomGuard — environment variables
# Copy to .env and fill in real values for production deployments.

# ─── App ──────────────────────────────────────────────────────────────────
APP_ENV=dev
APP_VERSION=2.0.0

# ─── Security ─────────────────────────────────────────────────────────────
# Generate with:  openssl rand -hex 32
SECRET_KEY=change-me-please-openssl-rand-hex-32
JWT_ACCESS_TTL_MINUTES=60
JWT_AGENT_TTL_DAYS=30

# Bootstrap admin (created on first run if no users exist)
BOOTSTRAP_ADMIN_EMAIL=admin@ransomguard.local
BOOTSTRAP_ADMIN_PASSWORD=ChangeMeOnFirstLogin!

# ─── Database ─────────────────────────────────────────────────────────────
POSTGRES_USER=ransomguard
POSTGRES_PASSWORD=ransomguard
POSTGRES_DB=ransomguard
DATABASE_URL=postgresql+psycopg://ransomguard:ransomguard@db:5432/ransomguard

# ─── Redis ────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ─── CORS ─────────────────────────────────────────────────────────────────
# JSON list. Add your production domains here.
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://127.0.0.1:5173"]

# ─── Logging ──────────────────────────────────────────────────────────────
LOG_LEVEL=INFO

# ─── Storage paths inside the container ───────────────────────────────────
STORAGE_DIR=/var/lib/ransomguard
UPLOADS_DIR=/var/lib/ransomguard/uploads
QUARANTINE_DIR=/var/lib/ransomguard/quarantine
MODELS_DIR=/var/lib/ransomguard/models
RULES_DIR=/var/lib/ransomguard/rules
MAX_UPLOAD_MB=100

# ─── Detector thresholds ──────────────────────────────────────────────────
THRESHOLD_LOW=0.40
THRESHOLD_MEDIUM=0.65
THRESHOLD_HIGH=0.85

# ─── Frontend ─────────────────────────────────────────────────────────────
VITE_API_URL=http://localhost:8000
