{
  "name": "GuardIAn SOC - Native Alerts and Detection Intelligence",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 15
            }
          ]
        }
      },
      "id": "schedule-alerts",
      "name": "Every 15 minutes",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        -860,
        40
      ]
    },
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "hours",
              "hoursInterval": 6
            }
          ]
        }
      },
      "id": "schedule-intel-sync",
      "name": "Every 6 hours",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        -860,
        320
      ],
      "disabled": true,
      "notes": "Enable only when the instance is allowed to refresh online TI/YARA feeds. GuardIAn already has an internal scheduler; this branch is for SOC-controlled refreshes."
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{$env.GUARDIAN_API_URL + '/auth/login'}}",
        "sendBody": true,
        "contentType": "form-urlencoded",
        "bodyParameters": {
          "parameters": [
            {
              "name": "username",
              "value": "={{$env.BOOTSTRAP_ADMIN_EMAIL}}"
            },
            {
              "name": "password",
              "value": "={{$env.BOOTSTRAP_ADMIN_PASSWORD}}"
            }
          ]
        },
        "options": {
          "timeout": 20000
        }
      },
      "id": "login-alerts",
      "name": "Login for alert digest",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        -620,
        40
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{$env.GUARDIAN_API_URL + '/auth/login'}}",
        "sendBody": true,
        "contentType": "form-urlencoded",
        "bodyParameters": {
          "parameters": [
            {
              "name": "username",
              "value": "={{$env.BOOTSTRAP_ADMIN_EMAIL}}"
            },
            {
              "name": "password",
              "value": "={{$env.BOOTSTRAP_ADMIN_PASSWORD}}"
            }
          ]
        },
        "options": {
          "timeout": 20000
        }
      },
      "id": "login-intel-sync",
      "name": "Login for intel refresh",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        -620,
        320
      ]
    },
    {
      "parameters": {
        "url": "={{$env.GUARDIAN_API_URL + '/threats?limit=25'}}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "={{'Bearer ' + $json.access_token}}"
            }
          ]
        },
        "options": {
          "timeout": 20000
        }
      },
      "id": "fetch-threats",
      "name": "Fetch GuardIAn alerts",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        -360,
        -40
      ]
    },
    {
      "parameters": {
        "url": "={{$env.GUARDIAN_API_URL + '/intel/stats'}}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "={{'Bearer ' + $items('Login for alert digest')[0].json.access_token}}"
            }
          ]
        },
        "options": {
          "timeout": 20000
        }
      },
      "id": "fetch-intel-stats",
      "name": "Fetch detection intelligence stats",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        -360,
        120
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{$env.GUARDIAN_API_URL + '/intel/refresh'}}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "={{'Bearer ' + $json.access_token}}"
            }
          ]
        },
        "options": {
          "timeout": 30000
        }
      },
      "id": "trigger-intel-refresh",
      "name": "Trigger TI and YARA refresh",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        -360,
        320
      ],
      "notes": "Admin-only GuardIAn endpoint. Refreshes MalwareBazaar, URLhaus, ThreatFox, Feodo, YARAify and optional feeds according to backend configuration."
    },
    {
      "parameters": {
        "jsCode": "function firstJson(name) {\n  try {\n    return $items(name)[0]?.json || {};\n  } catch (error) {\n    return {};\n  }\n}\nconst threatsPayload = firstJson('Fetch GuardIAn alerts');\nconst intel = firstJson('Fetch detection intelligence stats');\nconst threats = Array.isArray(threatsPayload) ? threatsPayload : (threatsPayload.items || threatsPayload.threats || []);\nconst threatList = Array.isArray(threats) ? threats : [];\nconst critical = threatList.filter(t => ['high', 'critical'].includes(String(t.severity || '').toLowerCase()));\nconst highConfidence = threatList.filter(t => Number(t.confidence || 0) >= 0.85);\nconst totals = intel.totals || {};\nconst staleFeeds = Object.entries(intel.last_runs || {})\n  .filter(([, run]) => run && run.status && run.status !== 'success')\n  .map(([feed, run]) => `${feed}:${run.status}`);\nconst lines = [];\nlines.push('*GuardIAn SOC Digest*');\nlines.push(`Alerts: ${threatList.length} recent / ${critical.length} high-critical / ${highConfidence.length} confidence >= 85%`);\nlines.push(`Detection intelligence: ${totals.hashes || 0} hashes, ${totals.indicators || 0} indicators, ${totals.yara_rules || 0} YARA rules`);\nif (staleFeeds.length) {\n  lines.push(`Feed attention: ${staleFeeds.slice(0, 5).join(', ')}`);\n}\nif (critical.length) {\n  lines.push('');\n  lines.push('*Top GuardIAn alerts*');\n  for (const threat of critical.slice(0, 5)) {\n    const score = Math.round(Number(threat.confidence || 0) * 100);\n    const rules = Array.isArray(threat.matched_rules) ? threat.matched_rules.slice(0, 3).join(', ') : '';\n    lines.push(`- [${threat.severity}] ${threat.threat_type || threat.type || 'threat'} (${score}%) ${threat.file_path || threat.path || ''}${rules ? ` | ${rules}` : ''}`);\n  }\n}\nconst shouldNotify = critical.length > 0 || staleFeeds.length > 0;\nreturn [{ json: { shouldNotify, text: lines.join('\\n'), threats: threatList, intel } }];"
      },
      "id": "format-native-digest",
      "name": "Format native SOC digest",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -80,
        40
      ]
    },
    {
      "parameters": {
        "jsCode": "const refresh = $items('Trigger TI and YARA refresh')[0]?.json || {};\nreturn [{ json: { shouldNotify: true, text: `*GuardIAn detection intelligence refresh*\\nAccepted: ${refresh.accepted === true}\\nScope: ${(refresh.only || ['all configured feeds']).join(', ')}` } }];"
      },
      "id": "format-refresh-result",
      "name": "Format refresh result",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -80,
        320
      ]
    },
    {
      "parameters": {
        "conditions": {
          "boolean": [
            {
              "value1": "={{$json.shouldNotify}}",
              "value2": true
            }
          ]
        }
      },
      "id": "has-soc-signal",
      "name": "Has SOC signal?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        180,
        40
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{$env.GUARDIAN_API_URL + '/chat'}}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "={{'Bearer ' + $items('Login for alert digest')[0].json.access_token}}"
            }
          ]
        },
        "sendBody": true,
        "contentType": "json",
        "jsonBody": "={{ { message: 'Resume ce digest SOC GuardIAn en francais et propose les 3 prochaines actions defensives.\\n\\n' + $json.text, language: 'fr' } }}",
        "options": {
          "timeout": 30000
        }
      },
      "id": "ask-guardian-chat",
      "name": "Ask GuardIAn chat for analyst summary",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        460,
        40
      ]
    },
    {
      "parameters": {
        "jsCode": "function nodeText(name) {\n  try {\n    return $items(name)[0]?.json?.text || '';\n  } catch (error) {\n    return '';\n  }\n}\nconst digest = nodeText('Format native SOC digest') || nodeText('Format refresh result');\nconst answer = $json.answer || $json.message || $json.response || '';\nreturn [{ json: { text: answer ? `${digest}\\n\\n*GuardIAn Assistant*\\n${answer}` : digest } }];"
      },
      "id": "merge-chat-summary",
      "name": "Merge chat summary",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        720,
        40
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{$env.DISCORD_WEBHOOK_URL}}",
        "sendBody": true,
        "contentType": "json",
        "jsonBody": "={{ { content: $json.text } }}",
        "options": {
          "timeout": 20000
        }
      },
      "id": "notify-discord",
      "name": "Notify Discord",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1000,
        -160
      ],
      "disabled": true,
      "notes": "Enable after setting DISCORD_WEBHOOK_URL."
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{'https://api.telegram.org/bot' + $env.TELEGRAM_BOT_TOKEN + '/sendMessage'}}",
        "sendBody": true,
        "contentType": "json",
        "jsonBody": "={{ { chat_id: $env.TELEGRAM_CHAT_ID, text: $json.text, parse_mode: 'Markdown' } }}",
        "options": {
          "timeout": 20000
        }
      },
      "id": "notify-telegram",
      "name": "Notify Telegram",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1000,
        40
      ],
      "disabled": true,
      "notes": "Enable after setting TELEGRAM_BOT_TOKEN and TELEGRAM_CHAT_ID."
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{$env.WHATSAPP_WEBHOOK_URL}}",
        "sendBody": true,
        "contentType": "json",
        "jsonBody": "={{ { text: $json.text, source: 'guardian-soc' } }}",
        "options": {
          "timeout": 20000
        }
      },
      "id": "notify-whatsapp",
      "name": "Notify WhatsApp provider webhook",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1000,
        240
      ],
      "disabled": true,
      "notes": "Enable after setting WHATSAPP_WEBHOOK_URL for an approved provider or internal bridge."
    }
  ],
